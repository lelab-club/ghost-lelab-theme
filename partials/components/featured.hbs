{{!--
Parameters:
* feed (index, home, archive, recent)
* postFeedStyle (list, grid)
* showTitle (true, false)
* showSidebar (true, false)
--}}

<section class="gh-container is-grid gh-outer">
    <div class="gh-container-inner gh-inner">
        <main class="gh-main">
            <div class="gh-feed">

                {{#get "posts" filter="featured:true" include="authors" limit=2 as |featured|}}
                    {{!-- All posts --}}
                    {{#foreach featured}}
                        {{> "post-highlight" lazyLoad=true}}
                    {{/foreach}}
                {{/get}}

            </div>
        </main>

    </div>
</section>